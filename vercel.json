{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,harvester/**,data/gm2000.db}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__p=/api/$1" }
  ]
}
