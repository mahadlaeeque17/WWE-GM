{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip - the build installs inside frontend/",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/**,harvester/**,data/gm2000.db}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__p=/api/$1" }
  ]
}
